# Keep the image small and reproducible.
.git
.gitignore
.venv
venv
__pycache__
*.pyc
.pytest_cache
.mypy_cache
.ruff_cache

# Runtime data / generated artefacts (recreated at start-up).
data/*.db
data/csv/*.csv
data/processed/*
exports/*
reports/*
logs/
*.log

# Local tooling
.vscode
.idea
.DS_Store
tests
